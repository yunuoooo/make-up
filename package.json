{
  "name": "looktrace-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "test:l1": "node --experimental-strip-types --test 'test/L1/**/*.test.ts'",
    "test:l3": "RUN_L3_E2E=1 node --experimental-strip-types --test 'test/L3/**/*.test.ts'",
    "test:python": "python3 -m unittest agent_service.test_runtime",
    "agent:dev": "python3 -m uvicorn agent_service.main:app --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
